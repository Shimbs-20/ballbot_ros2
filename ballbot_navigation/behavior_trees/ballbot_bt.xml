<?xml version="1.0" encoding="UTF-8"?>
<!--
  ballbot_bt.xml — Jazzy-compatible behavior tree
  Removed: is_recovery attribute (deprecated in Nav2 Jazzy/Iron)
  Removed: error_code_id attributes on Spin/BackUp (not in all Jazzy builds)
-->
<root BTCPP_format="4" main_tree_to_execute="Navigate">

  <BehaviorTree ID="Navigate">
    <RecoveryNode number_of_retries="3" name="NavigateWithRecovery">

      <!-- Main navigation pipeline -->
      <PipelineSequence name="NavigationPipeline">

        <!-- Replan at 1Hz -->
        <RateController hz="1.0" name="PlannerRateController">
          <RecoveryNode number_of_retries="1" name="ComputePathWithFallback">
            <ComputePathToPose
              goal="{goal}"
              path="{path}"
              planner_id="GridBased"
              error_code_id="{compute_path_error_code}"/>
            <ClearEntireCostmap
              name="ClearGlobalCostmap"
              service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>

        <!-- MPPI follows path at 10Hz -->
        <RecoveryNode number_of_retries="1" name="FollowPathWithFallback">
          <FollowPath
            path="{path}"
            controller_id="FollowPath"
            error_code_id="{follow_path_error_code}"/>
          <ClearEntireCostmap
            name="ClearLocalCostmap"
            service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>

      </PipelineSequence>

      <!-- Recovery when navigation fails -->
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <SequenceWithMemory name="RecoveryActions">

          <ClearEntireCostmap
            name="ClearLocal"
            service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap
            name="ClearGlobal"
            service_name="global_costmap/clear_entirely_global_costmap"/>

          <!-- Spin 360 to clear costmap and help AMCL re-localise -->
          <Spin spin_dist="3.14" time_allowance="15.0"/>

          <!-- Back up 0.3m away from obstacle -->
          <BackUp backup_dist="0.3" backup_speed="0.1" time_allowance="10.0"/>

          <!-- Wait then retry -->
          <Wait wait_duration="1.0"/>

        </SequenceWithMemory>
      </ReactiveFallback>

    </RecoveryNode>
  </BehaviorTree>

</root>