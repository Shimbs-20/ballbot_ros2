<?xml version="1.0" encoding="utf-8"?>
<robot name="ballbot_gp" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- <xacro:include filename="$(find gp_description)/urdf/ballbot1_gazebo.xacro" /> -->

  <xacro:include filename="$(find gp_description)/urdf/ballbot1_ros2_control.xacro" />

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0" />
  </material>

  <!-- <link name="world" /> -->
  
  <!-- <joint name="world_fixed_joint" type="fixed">
    <parent link="world" />
    <child link="base_footprint" />
    <origin xyz="0 0 0" rpy="0 0 0" /> 
  </joint> -->

  <link name="base_footprint" />

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_footprint" />
    <child link="base_link" />
  </joint>

<link name="base_link">
    <inertial>
      <origin
        xyz="0.00151517619990943 -0.0101643228259927 -1"
        rpy="0 0 0" />
      <mass
        value="9.08011858540185" />
      <inertia
        ixx="0.0572482708377235"
        ixy="-3.72978940239855E-05"
        ixz="1.06107104353966E-06"
        iyy="0.0578290554016623"
        iyz="2.4059994308814E-07"
        izz="0.0264771195240326" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gp_description/meshes/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gp_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>


  <link name="Sphere">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="3" />
      <inertia
        ixx="0.051133" ixy="-3.4559E-18" ixz="-6.9389E-18"
        iyy="0.051133" iyz="-5.6802E-18" izz="0.051133" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gp_description/meshes/Sphere.STL" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.15" />
      </geometry>
    </collision>
  </link>

<link name="dummy_rx">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6" />
    </inertial>
  </link>

  <link name="dummy_ry">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.01" />
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6" />
    </inertial>
  </link>

  <joint name="sphere_roll" type="continuous">
    <parent link="base_link" />
    <child link="dummy_rx" />
    <axis xyz="1 0 0" />
  </joint>

  <joint name="sphere_pitch" type="continuous">
    <parent link="dummy_rx" />
    <child link="dummy_ry" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="sphere_yaw" type="continuous">
    <parent link="dummy_ry" />
    <child link="Sphere" />
    <axis xyz="0 0 1" />
  </joint>


  <link name="wheel1">
    <inertial>
      <origin
        xyz="-0.00953560838269651 5.16370523984122E-05 6.79506333249869E-05"
        rpy="0 0 0" />
      <mass
        value="0.0951143292904188" />
      <inertia
        ixx="4.65646681900449E-05"
        ixy="-1.13818245667006E-11"
        ixz="-1.07929293045948E-12"
        iyy="2.52584891025476E-05"
        iyz="-1.4747785897974E-10"
        izz="2.52591526238032E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gp_description/meshes/wheel1.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gp_description/meshes/wheel1.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel1_joint" type="continuous">
    <origin
      xyz="0.12753 -0.061995 0.10342"
      rpy="-2.8521 0.7854 -0.46799" />
    <parent
      link="base_link" />
    <child
      link="wheel1" />
    <axis
      xyz="-1 0 0" />
    <limit
      effort="5"
      velocity="41.9" />
    <dynamics
      damping="0.5"
      friction="0.5" />
  </joint>

  <link name="wheel2">
    <inertial>
      <origin
        xyz="-0.00953560990942881 3.71902770169852E-05 -7.68172329284056E-05"
        rpy="0 0 0" />
      <mass
        value="0.0951143030835391" />
      <inertia
        ixx="4.65646613426977E-05"
        ixy="3.8456305497048E-12"
        ixz="1.11453090010958E-11"
        iyy="2.5259140158131E-05"
        iyz="-1.81644499264665E-10"
        izz="2.52584940578478E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gp_description/meshes/wheel2.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gp_description/meshes/wheel2.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel2_joint"
    type="continuous">
    <origin
      xyz="-0.0065232 0.14188 0.10313"
      rpy="3.0028 0.7854 1.6264" />
    <parent
      link="base_link" />
    <child
      link="wheel2" />
    <axis
      xyz="-1 0 0" />
    <limit
      effort="5"
      velocity="41.9" />
    <dynamics
      damping="0.5"
      friction="0.5" />
  </joint>

  <link name="wheel3">
    <inertial>
      <origin xyz="-0.0095356 -5.2218E-05 -6.7507E-05" rpy="0 0 0" />
      <mass
        value="0.095114" />
      <inertia
        ixx="4.6565E-05"
        ixy="1.147E-11"
        ixz="1.4905E-12"
        iyy="2.5258E-05"
        iyz="-1.4505E-10"
        izz="2.5259E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gp_description/meshes/wheel3.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gp_description/meshes/wheel3.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="wheel3_joint" type="continuous">
    <origin
      xyz="-0.12507 -0.080662 0.09342"
      rpy="-2.8751 0.7854 -2.5624" />
    <parent
      link="base_link" />
    <child
      link="wheel3" />
    <axis
      xyz="-1 0 0" />
    <limit
      effort="5"
      velocity="41.9" />
    <dynamics
      damping="0.5"
      friction="0.5" />
  </joint>

  <link name="Imu_link">
    <inertial>
      <origin
        xyz="-0.00927185847083811 -0.0178267300579023 -0.0166649394287217"
        rpy="0 0 0" />
      <mass
        value="0.0814778053289413" />
      <inertia
        ixx="6.20244789579876E-05"
        ixy="-1.06699641247436E-06"
        ixz="-3.89503586589482E-07"
        iyy="7.07115732356652E-05"
        iyz="-4.92347837572627E-07"
        izz="0.000131266449910669" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gp_description/meshes/Imu_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gp_description/meshes/Imu_link.STL" />
      </geometry>
    </collision>
  </link>
  
  <joint name="Imu_joint" type="fixed">
    <origin
      xyz="-0.0054505 0.024045 0.37651"
      rpy="0 0 0.013997" />
    <parent
      link="base_link" />
    <child
      link="Imu_link" />
    <axis
      xyz="0 0 0" />
  </joint>


  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.04" />
      </geometry>
      <material name="black" />
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_link" />
    <origin xyz="-0.007 0.126 0.7943" rpy="0 0 0" />
  </joint>


</robot>